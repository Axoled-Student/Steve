[ai]
    # AI provider to use: openai (default), groq, or gemini
    provider = "openai"

[openai]
    # Your OpenAI API key (optional for the default g4f endpoint)
    apiKey = ""
    
    # Default DeepSeek reasoning model served via DeepInfra
    model = "deepseek-ai/DeepSeek-R1-0528-Turbo"
    
    # Maximum tokens per API request
    maxTokens = 1000
    
    # Temperature (0.0-2.0, lower is more deterministic)
    temperature = 0.7

[behavior]
    # Ticks between action checks (20 ticks = 1 second)
    actionTickDelay = 20
    
    # Allow Steves to respond in chat
    enableChatResponses = true
    
    # Maximum number of Steves that can be active simultaneously
    maxActiveSteves = 10
